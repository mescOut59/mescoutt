---
import { offers, site, img } from '../data/site.js';
---
<section class="offers section" id="offers">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">специальные <span class="serif">предложения</span></h2>
      <p class="section-head__note reveal">Обновляем каждый месяц</p>
    </div>

    <div class="offers__grid">
      {offers.map((o) => (
        <article class="offer">
          <div class="media offer__img">
            <img src={img(o.photo, 1200)} alt="" loading="lazy" data-parallax="-12" />
          </div>
          <div class="offer__body">
            <h3 class="offer__title">{o.title}</h3>
            <ul class="offer__points">
              {o.points.map((p) => <li>{p}</li>)}
            </ul>
            <div class="offer__foot">
              <div>
                <span class="offer__discount">{o.discount}</span>
                <span class="offer__note">{o.note}</span>
              </div>
              <a href={site.bookingUrl} class="btn btn--glass btn--sm js-book"><span>Записаться</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
