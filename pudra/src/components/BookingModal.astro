---
import { site } from '../data/site.js';
---
<!-- Демо-окно: показывается, пока в site.js стоит ссылка-заглушка YCLIENTS -->
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
  <div class="modal__backdrop" data-close></div>
  <div class="modal__box">
    <button class="modal__close" data-close aria-label="Закрыть">✕</button>
    <p class="eyebrow">Онлайн-запись</p>
    <h3 id="modal-title" class="modal__title">Здесь откроется <span class="serif">онлайн-запись</span></h3>
    <p class="modal__text">
      Это демо-сайт. У реального клиента кнопка ведёт в его онлайн-запись:
      выбор мастера, услуги и времени — всё в привычной системе.
    </p>
    <a href={site.phoneHref} class="btn btn--dark"><span>Позвонить {site.phone}</span></a>
  </div>
</div>
