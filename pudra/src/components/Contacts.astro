---
import { site } from '../data/site.js';
const { lon, lat, zoom } = site.map;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=${zoom}&pt=${lon}%2C${lat}%2Cpm2rdl`;
---
<section class="contacts section" id="contacts">
  <div class="container">
    <div class="cta">
      <h2 class="cta__title">
        <span class="line"><span class="line__in">Запишитесь</span></span>
        <span class="line"><span class="line__in"><span class="serif">на заботу</span></span></span>
      </h2>
      <div class="cta__side reveal">
        <p>Выберите услугу, мастера и удобное время — онлайн, без звонков.</p>
        <a href={site.bookingUrl} class="btn btn--dark btn--xl js-book magnetic"><span>Записаться онлайн</span></a>
      </div>
    </div>

    <div class="contacts__grid">
      <div class="contacts__info">
        <dl class="contacts__list">
          <div class="reveal"><dt>Адрес</dt><dd>{site.city}, {site.address}<br /><small>{site.metro}</small></dd></div>
          <div class="reveal"><dt>Часы</dt><dd>{site.hours.map((h) => <span class="hours">{h.days}<b>{h.time}</b></span>)}</dd></div>
          <div class="reveal"><dt>Телефон</dt><dd><a href={site.phoneHref} class="link-line">{site.phone}</a></dd></div>
        </dl>
        <div class="contacts__socials reveal">
          <a href={site.telegram} target="_blank" rel="noopener" class="chip">Telegram</a>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="chip">WhatsApp</a>
          <a href={site.instagram} target="_blank" rel="noopener" class="chip">Instagram</a>
        </div>
      </div>
      <div class="contacts__map media media--reveal">
        <iframe src={mapSrc} title="Карта: как добраться до салона" loading="lazy" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
