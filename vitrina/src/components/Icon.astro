---
const { name, size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'phone' && <><rect x="6.5" y="2.5" width="11" height="19" rx="2.5" /><path d="M10.5 18.5h3" /></>}
  {name === 'bolt' && <path d="M13 2.5 4.5 13.5H11l-1 8 8.5-11H12z" />}
  {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 2.5v4M16 2.5v4M8.5 14.5l2 2 4-4" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'spark' && <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6" />}
  {name === 'edit' && <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16zM13.5 6.5l4 4" />}
  {name === 'arrow' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'plane' && <path d="M21 4 3 11l6 2.2L19 7l-7.6 7.6V20l3.3-3.9L18 18.6z" />}
  {name === 'chat' && <path d="M4 18.5V12a8 8 0 1 1 3.8 6.8z" />}
  {name === 'call' && <path d="M6.6 3.5h2.6l1.3 4-1.9 1.3a11 11 0 0 0 6.6 6.6l1.3-1.9 4 1.3v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
