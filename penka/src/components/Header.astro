---
import { site, nav } from '../data/site.js';
---
<header class="header">
  <div class="header__pill">
    <a href="#top" class="logo">{site.name}</a>
    <nav class="header__nav" aria-label="Основное меню">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="#places" class="btn btn--accent btn--sm"><span>Где мы</span></a>
  </div>
</header>
