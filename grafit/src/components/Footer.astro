---
import { site, nav } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <nav class="footer__nav" aria-label="Меню в подвале">
        {nav.map((item) => <a href={item.href} class="link-line">{item.label}</a>)}
      </nav>
      <a href="#top" class="footer__up link-line">Наверх ↑</a>
    </div>
    <div class="footer__logo" aria-hidden="true">
      {site.name.split('').map((ch) => <span class="footer__char">{ch}</span>)}
    </div>
    <div class="footer__bottom">
      <span>© {year} {site.fullName}</span>
      <span>Фото: Unsplash</span>
      <span>Демо-проект для портфолио</span>
    </div>
  </div>
</footer>
