---
import { site } from '../data/site.js';
---
<!-- Демо-окно: показывается, пока в site.js стоит ссылка-заглушка YCLIENTS -->
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
  <div class="modal__backdrop" data-close></div>
  <div class="modal__box">
    <button class="modal__close" data-close aria-label="Закрыть">✕</button>
    <span class="hand">бронь стола</span>
    <h3 id="modal-title" class="modal__title">Здесь откроется <span class="serif-i">бронирование</span></h3>
    <p class="modal__text">
      Это демо-сайт. У реального ресторана здесь откроется бронь:
      дата, время и число гостей — и стол ваш.
    </p>
    <a href={site.phoneHref} class="btn btn--gold"><span>Позвонить {site.phone}</span></a>
  </div>
</div>
